# ============================================================================
# ANDRADE CARDOSO ADVOCACIA - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ============================================================================
# INSTRUÇÕES DE SEGURANÇA CONTRA ATAQUES:
# 1. NUNCA faça commit de arquivos .env ou .env.local contendo chaves reais.
#    O arquivo .gitignore já está configurado para ignorar .env*.
# 2. Chaves privadas (ex: GEMINI_API_KEY) NUNCA devem ter o prefixo VITE_.
#    Variáveis com prefixo VITE_ são embutidas diretamente no código JavaScript
#    do navegador e ficam visíveis para qualquer atacante inspecionar!
# 3. Para desenvolvimento local:
#    cp .env.example .env.local
#    (preencha suas chaves no .env.local)
# 4. Em produção (Render, Vercel, Cloud Run, VPS):
#    Configure as variáveis diretamente no painel de controle do provedor.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CHAVES PRIVADAS DE BACKEND (SERVER-SIDE ONLY - CONFIDENCIAL)
# ----------------------------------------------------------------------------
# Chave da API do Google Gemini AI (usada estritamente no backend proxy /api/chat).
# NUNCA exponha no frontend.
GEMINI_API_KEY="sua_chave_gemini_api_aqui"

# Porta do servidor backend Node.js / Express
PORT=3000

# Ambiente de execução (development | production | test)
NODE_ENV="development"

# URL base da aplicação (usada para links absolutos, redirects e webhooks)
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 2. IDENTIFICADORES PÚBLICOS DE CLIENTE (FRONTEND - WEB SDK DO FIREBASE)
# ----------------------------------------------------------------------------
# ATENÇÃO: Variáveis com o prefixo VITE_ são públicas no bundle do navegador.
# Devem conter apenas identificadores públicos do app cliente Firebase.
# NUNCA coloque credenciais administrativas (Service Account) aqui!
VITE_FIREBASE_API_KEY="sua_chave_publica_firebase_web_aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef0123456789abcdef"
VITE_FIREBASE_DATABASE_ID="ai-studio-andradecardosoad-id"
VITE_GOOGLE_CLIENT_ID="seu_client_id.apps.googleusercontent.com"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
