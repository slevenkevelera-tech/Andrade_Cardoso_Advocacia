rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'slevenkevelera@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validator: User
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'role', 'createdAt', 'phone']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 150 &&
        data.email is string && data.email.size() <= 150 &&
        data.role in ['client', 'lawyer', 'admin'] &&
        data.createdAt is string;
    }

    // Entity validator: Consultation
    function isValidConsultation(data) {
      return data.keys().hasAll(['clientName', 'clientEmail', 'legalArea', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'clientName', 'clientEmail', 'clientPhone', 'legalArea', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.clientName is string && data.clientName.size() <= 150 &&
        data.clientEmail is string && data.clientEmail.size() <= 150 &&
        data.legalArea is string && data.legalArea.size() <= 100 &&
        data.message is string && data.message.size() <= 2000 &&
        data.status in ['pending', 'in_review', 'scheduled', 'completed', 'cancelled'] &&
        data.createdAt is string;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && isValidUser(incoming()) && incoming().role == 'client') || isAdmin();
      allow update: if (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Consultations Collection
    match /consultations/{consultationId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.clientEmail == request.auth.token.email);
      allow list: if isAdmin() || (isSignedIn() && resource.data.clientEmail == request.auth.token.email);
      allow create: if isValidConsultation(incoming()) && incoming().status == 'pending' && incoming().clientName.size() <= 150 && incoming().clientEmail.size() <= 150 && incoming().clientPhone.size() <= 30 && incoming().legalArea.size() <= 100 && incoming().message.size() <= 2000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
